OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=gpt-6-astra
# Úspora: delší strana fotky posílané do OpenAI (px) a úroveň detailu (low = nejlevnější, high = přesnější)
OPENAI_IMAGE_MAX_SIDE=1024
OPENAI_IMAGE_DETAIL=high
PORT=3000
# Generování obrázků (knihovna těl avatara, později oblečení na avatara)
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=medium

# Delší strana obrázku kusu, který jde do AI jako předloha při oblékání (menší = levnější)
OPENAI_REF_SIDE=768
